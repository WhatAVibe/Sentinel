<Application x:Class="Sentinel.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0D11" />
        <SolidColorBrush x:Key="Surface" Color="#12161C" />
        <SolidColorBrush x:Key="Elevated" Color="#171C24" />
        <SolidColorBrush x:Key="Line" Color="#2A3340" />
        <SolidColorBrush x:Key="Text" Color="#E6E9EF" />
        <SolidColorBrush x:Key="Muted" Color="#8B93A1" />
        <SolidColorBrush x:Key="Accent" Color="#6C8CFF" />
        <SolidColorBrush x:Key="AccentDim" Color="#26345C" />
        <SolidColorBrush x:Key="Success" Color="#6EE7A8" />
        <SolidColorBrush x:Key="Warning" Color="#F2C46D" />
        <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1218" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0E1218" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Elevated}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Application.Resources>
</Application>
