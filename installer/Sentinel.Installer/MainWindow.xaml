<Window x:Class="Sentinel.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel Setup" Height="640" Width="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/logo.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <StackPanel Margin="26,28,22,24">
                <TextBlock Text="Sentinel" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="VersionText" Text="Setup 2.0.0" FontSize="11" Foreground="{StaticResource Muted}"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="ModeText" Text="" FontSize="11" Foreground="{StaticResource Warning}"
                           Margin="0,2,0,0" />
                <StackPanel x:Name="StepList" Margin="0,32,0,0" />
                <TextBlock Text="Privacy first: nothing is sent to the creator. Your relay stores the data."
                           FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,32,0,0" />
                <TextBlock Text="admin@whatavibe.net" FontSize="10" Foreground="{StaticResource Accent}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,26,30,10">
                <Grid>
                    <StackPanel x:Name="StepWelcome">
                        <TextBlock Text="Welcome to Sentinel" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="20"
                                   Text="Sentinel lets you control and monitor this PC from your phone or watch through a relay you host yourself. This wizard installs the agent, connects it to your relay and links your first device." />
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="What gets installed" FontWeight="SemiBold" />
                                <TextBlock Text="• Sentinel agent in %APPDATA%\Sentinel" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                                <TextBlock Text="• Start with Windows (optional)" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                <TextBlock Text="• An uninstaller entry in Windows Settings" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="ManagePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,18,0,0">
                            <Button Content="Update / Repair" Style="{StaticResource Primary}" Padding="16,8"
                                    Margin="0,0,8,0" Click="UpdateMode_Click" />
                            <Button Content="Uninstall" Style="{StaticResource DangerButton}" Padding="16,8"
                                    Click="UninstallExisting_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="StepLicense" Visibility="Collapsed">
                        <TextBlock Text="Terms and privacy" FontSize="22" FontWeight="SemiBold" />
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,16,0,0">
                            <ScrollViewer Height="250" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Muted}"
                                               Text="Sentinel is self-hosted remote administration software for devices you own. You are responsible for how you deploy it and who you grant access to." />
                                    <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" Foreground="{StaticResource Muted}"
                                               Text="Nothing you do in Sentinel is sent to the creator. There is no telemetry, no analytics, no cloud account and no remote access from WhatAVibe. The only network services involved are your relay server and the GitHub releases page used for update checks (only the public release metadata is requested; no device data is included)." />
                                    <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" Foreground="{StaticResource Muted}"
                                               Text="Your relay stores: device name, platform, agent version, heartbeat metrics (CPU, memory, uptime, session), activity events you enable, messages, screenshots you take, and linked device names/tokens. Clipboard capture and keystroke capture are off by default and gated. Screenshots and events stay on your relay until you delete them or retention removes them." />
                                    <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" Foreground="{StaticResource Muted}"
                                               Text="Tokens are hashed on the relay; the agent token and TOTP secret are protected with Windows DPAPI on this PC. You can purge screenshots, unpair this PC, or uninstall and wipe all data at any time." />
                                    <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" Foreground="{StaticResource Muted}"
                                               Text="Questions or reports: admin@whatavibe.net" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <CheckBox x:Name="AcceptCheck" Content="I have read and accept the terms and privacy policy" Margin="0,16,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="StepLocation" Visibility="Collapsed">
                        <TextBlock Text="Install location" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="The agent, config, logs and screenshots live here (Roaming)." Foreground="{StaticResource Muted}"
                                   Margin="0,8,0,0" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocationBox" Padding="10,9" />
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Click="Browse_Click" />
                        </Grid>
                        <CheckBox x:Name="StartupCheck" Content="Start Sentinel with Windows" IsChecked="True" Margin="0,16,0,0" />
                        <CheckBox x:Name="UpdatesCheck" Content="Automatically check for updates (GitHub releases only)" IsChecked="True" Margin="0,8,0,0" />
                        <TextBlock Text="Updates are never installed silently: you get a notice and a link to the release page."
                                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="StepSecurity" Visibility="Collapsed">
                        <TextBlock Text="Recovery password" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="19"
                                   Text="A master password unlocks this PC locally if your linked devices are lost. It is stored only on this PC, protected by Windows DPAPI, and can be changed or cleared later from Settings using a linked device." />
                        <Label Content="Password (at least 8 characters)" Margin="0,18,0,4" />
                        <PasswordBox x:Name="MasterBox" Padding="10,9" />
                        <Label Content="Confirm password" Margin="0,12,0,4" />
                        <PasswordBox x:Name="MasterConfirmBox" Padding="10,9" />
                    </StackPanel>

                    <StackPanel x:Name="StepRelay" Visibility="Collapsed">
                        <TextBlock Text="Connect to your relay" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="19"
                                   Text="Enter the address of the relay you host (for example https://sentinel.example.com)." />
                        <TextBox x:Name="ServerBox" Padding="10,9" Margin="0,16,0,0" />
                        <Button Content="Don't have a relay? Set one up" Style="{StaticResource Link}" Margin="0,10,0,0"
                                Click="RelayHelp_Click" />
                    </StackPanel>

                    <StackPanel x:Name="StepPair" Visibility="Collapsed">
                        <TextBlock Text="Link your first device" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="19"
                                   Text="Start pairing, then open Sentinel on your phone or watch and enter the code shown below. After approving, the device shows a 6-digit 2FA code — type it here to confirm the device." />
                        <Button x:Name="StartPairButton" Content="Start pairing" Style="{StaticResource Primary}"
                                Margin="0,16,0,0" HorizontalAlignment="Left" Click="StartPair_Click" />
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Pairing code" FontSize="11" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="PairCodeText" Text="------" FontSize="30" FontFamily="Consolas"
                                           FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                                <TextBlock x:Name="PairStatusText" Text="Waiting to start." FontSize="11"
                                           Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Image x:Name="PairQr" Width="170" Height="170" Margin="0,14,0,0"
                               HorizontalAlignment="Left" Visibility="Collapsed" />
                        <Label Content="2FA code shown on the new device" Margin="0,14,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConfirmCodeBox" MaxLength="6" FontFamily="Consolas" FontSize="20"
                                     Padding="10,8" />
                            <Button Grid.Column="1" x:Name="ConfirmButton" Content="Confirm device" Style="{StaticResource Primary}"
                                    Margin="8,0,0,0" Click="ConfirmDevice_Click" IsEnabled="False" />
                        </Grid>
                        <Button x:Name="SkipPairButton" Content="Skip for now (link a device later)" Style="{StaticResource Link}"
                                Margin="0,10,0,0" Click="SkipPair_Click" />
                    </StackPanel>

                    <StackPanel x:Name="StepFinish" Visibility="Collapsed">
                        <TextBlock x:Name="FinishTitle" Text="Ready to install" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="FinishSummary" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Margin="0,10,0,0" LineHeight="20" />
                        <ProgressBar x:Name="InstallProgress" Height="6" Margin="0,18,0,0" Minimum="0" Maximum="100"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="ProgressText" Foreground="{StaticResource Muted}" FontSize="11"
                                   Margin="0,6,0,0" />
                        <CheckBox x:Name="LaunchCheck" Content="Launch Sentinel when setup finishes" IsChecked="True" Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="30,14">
                <Grid>
                    <TextBlock x:Name="FooterStatus" Foreground="{StaticResource Muted}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" Content="Back" Style="{StaticResource Ghost}" Margin="0,0,8,0"
                                Click="Back_Click" />
                        <Button x:Name="NextButton" Content="Next" Style="{StaticResource Primary}" Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
