<Window x:Class="Sentinel.Views.DeviceConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm new device" Height="330" Width="470" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="New device wants to link" Style="{StaticResource H2}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="26" Padding="14,10"
                     TextAlignment="Center" MaxLength="6" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,8,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap" />
            <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Nothing on the new device can be triggered until this code is entered here."
                   Style="{StaticResource MutedText}" VerticalAlignment="Bottom" TextWrapping="Wrap" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button Content="Not now" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Padding="16,8" Click="Later_Click" />
            <Button x:Name="ConfirmButton" Content="Confirm device" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Padding="20,8" Click="Confirm_Click" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
