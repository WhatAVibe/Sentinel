<Window x:Class="Sentinel.Views.PhoneLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair another phone" Height="700" Width="520" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Pair another phone" Style="{StaticResource H1}" />
            <TextBlock Text="Scan this code in Sentinel to add this PC to that phone."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="QrPanel" Background="White" CornerRadius="12" Padding="10">
                    <Image x:Name="QrImage" Width="230" Height="230" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />

                <StackPanel x:Name="ConfirmPanel" Margin="0,14,0,0" Visibility="Collapsed"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="ConfirmTitle" Text="Enter the 6-digit code shown on the device"
                               FontSize="12" Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                    <TextBox x:Name="ConfirmBox" FontFamily="Consolas" FontSize="26" Padding="12,8"
                             TextAlignment="Center" MaxLength="6" Width="220" Margin="0,8,0,0"
                             Background="#0E1218" Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Line}" BorderThickness="1"
                             TextChanged="ConfirmBox_TextChanged" />
                    <TextBlock x:Name="ConfirmError" Foreground="{StaticResource Danger}" FontSize="11"
                               Margin="0,6,0,0" Visibility="Collapsed" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="340" />
                    <Button x:Name="ConfirmButton" Content="Confirm device" Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,0" Padding="18,9" Click="Confirm_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="The code is valid for ten minutes." Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <Button Content="Done" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="18,9"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
