<Window x:Class="Sentinel.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Width="430" SizeToContent="Height"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
    <Border Background="#F512161C" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="18" Padding="20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="12"
                        Background="{StaticResource Accent}" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets"
                               Foreground="White" FontSize="15" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Message from your phone" FontSize="14"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="KindText" Text="MESSAGE" FontSize="9" Foreground="{StaticResource Muted}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        VerticalAlignment="Top" Click="Dismiss_Click">
                    <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" Stroke="{StaticResource Muted}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <TextBlock x:Name="BodyText" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                       LineHeight="19" />

            <StackPanel x:Name="ReplyPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBox x:Name="ReplyBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="96"
                         VerticalScrollBarVisibility="Auto" Padding="10,8" />
                <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="TimerText" FontSize="11" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                    <Button Content="Send reply" Style="{StaticResource PrimaryButton}" Padding="16,8"
                            HorizontalAlignment="Right" Click="Send_Click" />
                </Grid>
            </StackPanel>

            <Grid x:Name="Footer" Margin="0,14,0,0">
                <TextBlock x:Name="CountdownText" FontSize="11" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" />
                <Button Content="Dismiss" Style="{StaticResource GhostButton}" Padding="16,8"
                        HorizontalAlignment="Right" Click="Dismiss_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
