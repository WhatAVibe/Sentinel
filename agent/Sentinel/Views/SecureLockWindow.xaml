<Window x:Class="Sentinel.Views.SecureLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="#050608" FontFamily="Segoe UI"
        Title="Sentinel secure lock">
    <Grid>
        <Canvas x:Name="WallpaperCanvas" ClipToBounds="True" Background="#070A0F" />
        <Border Background="#4D000000" />
        <Border Width="400" CornerRadius="20" Background="#F012161C" BorderBrush="#2A3340"
                BorderThickness="1" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="This PC is locked" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Sentinel secure lock" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                           Margin="0,16,0,0" Foreground="{StaticResource Text}" />

                <TextBlock Text="Enter the 6-digit code to unlock."
                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,6" />
                <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="26" Padding="12,9"
                         TextAlignment="Center" MaxLength="6" BorderThickness="1"
                         Background="#0E1218" Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource Line}"
                         PreviewTextInput="CodeBox_PreviewTextInput"
                         TextChanged="CodeBox_TextChanged" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12"
                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                <Button Content="Unlock" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                        Padding="18,10" Click="Unlock_Click" IsDefault="True" />

                <Button x:Name="OtherOptionsButton" Content="Other options" Style="{StaticResource GhostButton}"
                        Margin="0,10,0,0" Padding="14,8" Click="ToggleOptions_Click" />
                <StackPanel x:Name="OtherPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <Border x:Name="MasterPanel" Background="#0E1218" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Recovery password" FontSize="11"
                                       Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <PasswordBox x:Name="MasterBox" Padding="10,8" />
                            <Button Content="Unlock with recovery password" Style="{StaticResource GhostButton}"
                                    Margin="0,8,0,0" Padding="14,8" Click="MasterUnlock_Click" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="KeyButton" Content="Use security key" Style="{StaticResource GhostButton}"
                            Margin="0,8,0,0" Padding="14,8" Click="Key_Click" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock Text="Ctrl+Alt+Delete still belongs to Windows."
                           FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
