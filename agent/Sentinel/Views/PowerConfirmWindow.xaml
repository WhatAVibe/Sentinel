<Window x:Class="Sentinel.Views.PowerConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Border Background="#F5141922" BorderBrush="#4A3A1E" BorderThickness="1" CornerRadius="18" Padding="22">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource Warning}">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="Black" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Shut down this PC?" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountdownText" Text="30s" FontSize="11" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="MessageText" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                       Margin="0,16,0,0" Foreground="{StaticResource Text}" />
            <TextBlock Text="This request came from your phone. Nothing happens unless you allow it."
                       FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <Grid Margin="0,20,0,0">
                <Button Content="Deny" Style="{StaticResource GhostButton}" Padding="18,10"
                        HorizontalAlignment="Left" Click="Deny_Click" />
                <Button Content="Allow" Style="{StaticResource PrimaryButton}" Padding="22,10"
                        HorizontalAlignment="Right" Click="Allow_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
