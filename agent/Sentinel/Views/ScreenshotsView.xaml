<UserControl x:Class="Sentinel.Views.ScreenshotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="26,22,18,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Screenshots" Style="{StaticResource H1}" />
                <TextBlock Text="Local captures from every display" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ShotCount, StringFormat={}{0} saved}" FontSize="11" />
                </Border>
                <Button x:Name="CaptureButton" Content="Capture now" Style="{StaticResource PrimaryButton}"
                        Padding="14,8" Margin="0,0,8,0" Click="Capture_Click" />
                <Button Content="Purge from relay" Style="{StaticResource DangerButton}" Padding="14,8"
                        Margin="0,0,8,0" Click="PurgeRelay_Click" />
                <Button Content="Open folder" Style="{StaticResource GhostButton}" Padding="14,8" Click="Folder_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Shots}" PreviewMouseLeftButtonUp="Shots_PreviewMouseLeftButtonUp">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding EmptyShotsVisibility}">
                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                <TextBlock Text="No captures yet" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Use Capture now, the tray menu, or your phone." Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
