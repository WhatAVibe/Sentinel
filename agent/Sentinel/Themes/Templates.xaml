<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:Sentinel.Services">

    <DataTemplate DataType="{x:Type svc:ActivityItem}">
        <Border Margin="0,0,0,2" Padding="0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding Accent}" CornerRadius="2" Width="3" Margin="0,2" />
                <StackPanel Grid.Column="1" Margin="12,0,14,0">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                    <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource Muted}" FontSize="11"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"
                               Visibility="{Binding DetailVisibility}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Muted}" FontSize="11"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource Muted}" FontSize="9"
                               HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type svc:ShotItem}">
        <Border Style="{StaticResource InnerCard}" Margin="0,0,12,12" Width="238" Padding="10">
            <StackPanel>
                <Border CornerRadius="8" Background="#0A0C10" Height="126" ClipToBounds="True">
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{Binding Caption}" Margin="0,9,0,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,3,0,0">
                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding TriggerText}" Foreground="{StaticResource Muted}" FontSize="9"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
