<Window x:Class="PCMonitor.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel" Height="780" Width="1200" MinHeight="640" MinWidth="980"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="234" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,24">
                    <Border Width="36" Height="36" CornerRadius="11" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Sentinel" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="remote control" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="Nav" Grid.Row="1" SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Text="Activity" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Text="Screenshots" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Text="Logs" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource InnerCard}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Connection" FontSize="11" Foreground="{StaticResource Muted}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Connection}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding ServerLabel}" FontSize="11" Foreground="{StaticResource Muted}"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <Border Background="#10141A" CornerRadius="8" Padding="8,6" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeviceName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="agent v1.2.4" FontSize="10" Foreground="{StaticResource Muted}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="Body" Grid.Column="1" />
    </Grid>
</Window>
