<Window x:Class="PCMonitor.Agent.Views.PhoneLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair another phone" Height="640" Width="520" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Pair another phone" Style="{StaticResource H1}" />
            <TextBlock Text="Scan this code in Sentinel to add this PC to that phone."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="12" Padding="10">
                    <Image x:Name="QrImage" Width="230" Height="230" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="The code is valid for ten minutes." Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <Button Content="Done" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="18,9"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
