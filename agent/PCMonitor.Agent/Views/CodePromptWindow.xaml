<Window x:Class="PCMonitor.Agent.Views.CodePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify code" Height="360" Width="470" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Unlock / disable away mode" Style="{StaticResource H2}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="26" Padding="14,10"
                     TextAlignment="Center" MaxLength="9" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,8,0,0"
                       Visibility="Collapsed" />
            <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Open Sentinel on your phone → Security → live code. Any TOTP authenticator works."
                   Style="{StaticResource MutedText}" VerticalAlignment="Bottom" TextWrapping="Wrap" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="16,8"
                    Click="Cancel_Click" />
            <Button Content="Verify" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    Padding="20,8" Click="Verify_Click" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
