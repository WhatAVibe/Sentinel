<Window x:Class="PCMonitor.Agent.Views.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Sentinel" Height="720" Width="560" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="12" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pair this PC" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Scan the code with Sentinel on your phone" Style="{StaticResource MutedText}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="Relay server address" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerBox" Padding="10,9" />
                <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Style="{StaticResource PrimaryButton}"
                        Padding="18,9" Margin="8,0,0,0" Click="Connect_Click" />
            </Grid>
            <CheckBox x:Name="InsecureCheck" Content="Allow self-signed HTTPS certificate" Margin="0,8,0,0" />
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="CodePanel" Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <Border Background="White" CornerRadius="12" Padding="10" HorizontalAlignment="Center">
                    <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Text="or enter this code on the phone" Style="{StaticResource MutedText}" Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="CountdownText" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
                <TextBlock Text="The phone must be on the same network as this PC, or the server must be reachable over the internet."
                           Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,10,0,0" MaxWidth="360" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Sentinel never stores your Windows password." Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="18,9"
                    Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
