<Window x:Class="PCMonitor.Agent.Views.FullscreenMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="#050608" FontFamily="Segoe UI">
    <Grid>
        <Image Source="pack://application:,,,/Assets/wallpaper.png" Stretch="Uniform" Opacity="0.4"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border Background="#C4070A0F" />
        <Border Width="560" CornerRadius="22" Background="#F012161C" BorderBrush="#2A3340"
                BorderThickness="1" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Text="Message from your phone" />
                        <TextBlock Text="SENTINEL · FULLSCREEN" FontSize="9" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="BodyText" FontSize="15" TextWrapping="Wrap" LineHeight="22"
                           Margin="0,20,0,0" />
                <Button Content="Dismiss" Style="{StaticResource GhostButton}" Margin="0,24,0,0"
                        Padding="18,10" HorizontalAlignment="Right" Click="Dismiss_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
