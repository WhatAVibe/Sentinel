<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sentinel_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/action_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/sentinel_widget_button"
            android:text="Lock"
            android:textColor="#E6E9EF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/action_secure"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/sentinel_widget_button"
            android:text="Secure"
            android:textColor="#E6E9EF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/action_away"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/sentinel_widget_button"
            android:text="Away"
            android:textColor="#E6E9EF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/action_shot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/sentinel_widget_button"
            android:text="Shot"
            android:textColor="#E6E9EF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/action_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="Open Sentinel"
        android:textColor="#6C8CFF"
        android:textSize="10sp" />
</LinearLayout>
